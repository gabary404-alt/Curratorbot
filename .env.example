# Default mode is safe, offline MOCK. Change only after API smoke tests.
CURRATOR_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Google Search grounding is unavailable on this model's free tier.
GOOGLE_SEARCH_GROUNDING=false
# Optional: extracted Vosk English model directory. Requires FFmpeg and .[english].
VOSK_MODEL_PATH=
PINDO_API_TOKEN=
# Leave empty to use Pindo's unauthenticated, rate-limited /public API.
PINDO_MEDIA_BASE_URL=
WIKIMEDIA_USER_AGENT=CurratorBot/0.1 (school-demo; contact: replace-with-email@example.com)
# Motions are OFF until firmware interlocks and sensors pass hardware acceptance.
ENABLE_MOTION=false
ROBOT_TRANSPORT=mock
ROBOT_SERIAL_PORT=
ROBOT_SERIAL_BAUD=115200
# A random secret, never committed. REQUIRED for all motor-control requests.
ROBOT_OPERATOR_TOKEN=
